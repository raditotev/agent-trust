{
  "uid": "agent-trust-tools",
  "title": "AgentTrust \u2014 MCP Tool Usage",
  "tags": [
    "agent-trust",
    "mcp"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Tool Calls",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(agent_trust_tool_calls_total)",
          "legendFormat": "Total",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Successful Calls",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(agent_trust_tool_calls_total{status=\"success\"})",
          "legendFormat": "Success",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            {
              "color": "green",
              "value": null
            }
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Calls",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(agent_trust_tool_calls_total{status=\"error\"})",
          "legendFormat": "Errors",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "green",
              "value": null
            },
            {
              "color": "yellow",
              "value": 1
            },
            {
              "color": "red",
              "value": 10
            }
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error Rate",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(agent_trust_tool_calls_total{status=\"error\"}[5m])) / sum(rate(agent_trust_tool_calls_total[5m])) * 100",
          "legendFormat": "Error %",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "unit": "percent",
        "colorMode": "background",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "green",
              "value": null
            },
            {
              "color": "yellow",
              "value": 1
            },
            {
              "color": "red",
              "value": 5
            }
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tool Call Rate (calls/min)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (tool_name) (rate(agent_trust_tool_calls_total[1m])) * 60",
          "legendFormat": "{{ tool_name }}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tool Latency \u2014 p50 / p95 / p99 (seconds)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (tool_name, le) (rate(agent_trust_tool_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{ tool_name }}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (tool_name, le) (rate(agent_trust_tool_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{ tool_name }}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (tool_name, le) (rate(agent_trust_tool_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{ tool_name }}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Total Calls by Tool",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (tool_name) (agent_trust_tool_calls_total))",
          "legendFormat": "{{ tool_name }}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Errors by Tool and Type",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (tool_name, error_type) (agent_trust_tool_errors_total))",
          "legendFormat": "{{ tool_name }} / {{ error_type }}",
          "instant": true,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": false
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "row",
      "title": "MCP Protocol & HTTP",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": [],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "MCP Requests/sec by Method",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (method) (rate(agent_trust_mcp_requests_total[1m]))",
          "legendFormat": "{{ method }}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "MCP Request Error Rate by Method",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (method) (rate(agent_trust_mcp_requests_total{status=\"error\"}[5m]))",
          "legendFormat": "{{ method }}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Authenticated vs Anonymous Tool Calls",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (authenticated) (rate(agent_trust_tool_calls_total[1m])) * 60",
          "legendFormat": "{{ authenticated }}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests/sec by Route and Status",
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (path, status) (rate(agent_trust_http_requests_total[1m]))",
          "legendFormat": "{{ path }} {{ status }}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 13
    },
    {
      "type": "stat",
      "title": "HTTP In-Flight",
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "agent_trust_http_in_flight",
          "legendFormat": "in-flight",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 14
    },
    {
      "type": "row",
      "title": "Background Worker",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": [],
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Job Rate by Job Name (runs/min)",
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (job_name, status) (rate(agent_trust_job_runs_total[5m])) * 60",
          "legendFormat": "{{ job_name }} ({{ status }})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "Job Duration \u2014 p95 (seconds)",
      "gridPos": {
        "x": 12,
        "y": 50,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (job_name, le) (rate(agent_trust_job_duration_seconds_bucket[15m])))",
          "legendFormat": "{{ job_name }}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 17
    },
    {
      "type": "table",
      "title": "Job Errors by Job and Type",
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (job_name, error_type) (agent_trust_job_errors_total))",
          "legendFormat": "{{ job_name }} / {{ error_type }}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": false
            }
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 18
    },
    {
      "type": "row",
      "title": "Containers",
      "gridPos": {
        "x": 0,
        "y": 67,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": [],
      "id": 19
    },
    {
      "type": "timeseries",
      "title": "Memory by Container",
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{image=~\".*agent-trust.*\"}",
          "legendFormat": "{{ image }} / {{ id }}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 20
    },
    {
      "type": "timeseries",
      "title": "CPU by Container",
      "gridPos": {
        "x": 12,
        "y": 68,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (image, id) (rate(container_cpu_usage_seconds_total{image=~\".*agent-trust.*\"}[5m]))",
          "legendFormat": "{{ image }} / {{ id }}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 21
    },
    {
      "type": "timeseries",
      "title": "Container Restarts (changes in 1h)",
      "gridPos": {
        "x": 0,
        "y": 76,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "changes(container_start_time_seconds{image=~\".*agent-trust.*\"}[1h])",
          "legendFormat": "{{ image }} / {{ id }}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 22
    },
    {
      "type": "row",
      "title": "Logs",
      "gridPos": {
        "x": 0,
        "y": 85,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": [],
      "id": 23
    },
    {
      "type": "timeseries",
      "title": "Log Volume by Level",
      "gridPos": {
        "x": 0,
        "y": 86,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (rate({compose_project=\"agent-trust\"} | json level=\"level\" | level != \"\" [1m]))",
          "refId": "A",
          "legendFormat": "{{level}}"
        }
      ],
      "id": 24
    },
    {
      "type": "stat",
      "title": "Warning/Error Rate",
      "gridPos": {
        "x": 0,
        "y": 94,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "green",
              "value": null
            },
            {
              "color": "yellow",
              "value": 0.1
            },
            {
              "color": "red",
              "value": 1
            }
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({compose_project=\"agent-trust\"} | json level=\"level\" | level=~\"warning|error\" [1m]))",
          "refId": "A",
          "legendFormat": "warn+error/s"
        }
      ],
      "id": 25
    },
    {
      "type": "table",
      "title": "Top Warning/Error Events",
      "gridPos": {
        "x": 6,
        "y": 94,
        "w": 18,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (event) (count_over_time({compose_project=\"agent-trust\"} | json event=\"event\", level=\"level\" | level=~\"warning|error\" [5m])))",
          "refId": "A",
          "legendFormat": "{{event}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": false
            }
          }
        }
      ],
      "id": 26
    },
    {
      "type": "logs",
      "title": "Recent Warnings/Errors",
      "gridPos": {
        "x": 0,
        "y": 102,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{compose_project=\"agent-trust\"} | json level=\"level\" | level=~\"warning|error\"",
          "refId": "A"
        }
      ],
      "id": 27
    }
  ]
}